# ScopeShield — code phase
# Track code + demo data. Never commit secrets or real client data.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets (never commit real keys)
.env
.env.*
!.env.example

# Node / Frontend build
node_modules/
dist/
build/
.vite/
*.log
*.tsbuildinfo

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Data — ignore real client dumps, allow demo/baseline
*.pdf
*.db
*.sqlite
*.dump
data/uploads/
data/raw/
!data/demo_*.csv
!data/demo_*.md
!data/baseline_*.csv

# Local infra
.render/
.sentryclirc
coverage/


